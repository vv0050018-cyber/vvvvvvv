# PREPAI Environment Configuration
# Copy this file to .env and configure values

# Flask Secret Key for session encryption
SECRET_KEY=prepai-super-secret-development-key-change-in-production

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1

# Optional Gemini or OpenAI API Key for live AI evaluation.
# If omitted or left empty, PREPAI automatically uses the built-in Intelligent Rule-Based Evaluator.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database configuration
DATABASE_PATH=database/prepai.db
